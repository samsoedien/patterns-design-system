{
  "name": "@project-cuoio/core",
  "version": "0.0.1",
  "type": "module",
  "repository": "https://github.com/samsoedien/project-cuoio/tree/main/packages/core",
  "files": [
    "lib"
  ],
  "module": "./lib/esm/index.js",
  "main": "./lib/cjs/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./compact": {
      "types": "./lib/types/compact.d.ts",
      "import": "./lib/esm/compact.js",
      "require": "./lib/cjs/compact.js"
    },
    "./lib/globals.css": {
      "default": "./lib/globals.css"
    }
  },
  "scripts": {
    "compile": "vite",
    "build": "tsc -b && vite build && yarn build:styles",
    "build:styles": "yarn dlx @tailwindcss/cli -i ./src/styles/globals.css  -o ./lib/globals.css --postcss --minify",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "check-types": "tsc -b",
    "preview": "vite preview",
    "ui:init": "yarn dlx shadcn@latest init",
    "ui:add": "yarn dlx shadcn@latest add",
    "ui:build": "yarn dlx shadcn@latest build",
    "ui:diff": "yarn dlx shadcn@latest diff",
    "registry:build": "shadcn build",
    "registry:publish": "yarn registry:build && yarn compile",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "yarn run -T rimraf node_modules lib"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@project-cuoio/icons": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-subscript": "^3.33.1",
    "@tiptap/extension-superscript": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-typography": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "frimousse": "^0.4.0",
    "fuse.js": "^7.5.0",
    "input-otp": "^1.5.0",
    "lowlight": "^3.3.0",
    "lucide-react": "1.72.0",
    "motion": "^14.12.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.7",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.5",
    "tippy.js": "^6.3.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-storysource": "8.6.14",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/color": "^4.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "playwright": "latest",
    "storybook": "^10.6.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
